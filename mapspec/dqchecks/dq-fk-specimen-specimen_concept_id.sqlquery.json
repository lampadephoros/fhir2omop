{
  "resourceType": "Library",
  "id": "dq-fk-specimen-specimen_concept_id",
  "url": "https://fhir2omop.health-samurai.io/StructureDefinition/Library/dq-fk-specimen-specimen_concept_id",
  "name": "dq_fk_specimen_specimen_concept_id",
  "title": "specimen.specimen_concept_id SHALL reference an existing concept.concept_id",
  "status": "active",
  "type": {
    "coding": [
      {
        "system": "http://hl7.org/fhir/uv/sql-on-fhir/CodeSystem/library-type",
        "code": "sqlquery"
      }
    ]
  },
  "extension": [
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-kahn-category",
      "valueCode": "conformance"
    },
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-check-type",
      "valueString": "isForeignKey"
    },
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-threshold-pct",
      "valueDecimal": 0
    },
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-severity",
      "valueCode": "error"
    }
  ],
  "parameter": [
    {
      "name": "cdmTable",
      "use": "in",
      "valueString": "specimen"
    },
    {
      "name": "cdmField",
      "use": "in",
      "valueString": "specimen_concept_id"
    }
  ],
  "content": [
    {
      "contentType": "text/sql",
      "data": "SELECT a.* FROM cdm_ours_fhir.specimen a WHERE a.specimen_concept_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM vocab.concept b WHERE b.concept_id = a.specimen_concept_id)"
    }
  ]
}
