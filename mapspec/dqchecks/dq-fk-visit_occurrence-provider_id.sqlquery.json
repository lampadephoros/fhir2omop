{
  "resourceType": "Library",
  "id": "dq-fk-visit_occurrence-provider_id",
  "url": "https://fhir2omop.health-samurai.io/StructureDefinition/Library/dq-fk-visit_occurrence-provider_id",
  "name": "dq_fk_visit_occurrence_provider_id",
  "title": "visit_occurrence.provider_id SHALL reference an existing provider.provider_id",
  "status": "active",
  "type": {
    "coding": [
      {
        "system": "http://hl7.org/fhir/uv/sql-on-fhir/CodeSystem/library-type",
        "code": "sqlquery"
      }
    ]
  },
  "extension": [
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-kahn-category",
      "valueCode": "conformance"
    },
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-check-type",
      "valueString": "isForeignKey"
    },
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-threshold-pct",
      "valueDecimal": 0
    },
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-severity",
      "valueCode": "error"
    }
  ],
  "parameter": [
    {
      "name": "cdmTable",
      "use": "in",
      "valueString": "visit_occurrence"
    },
    {
      "name": "cdmField",
      "use": "in",
      "valueString": "provider_id"
    }
  ],
  "content": [
    {
      "contentType": "text/sql",
      "data": "SELECT a.* FROM cdm_ours_fhir.visit_occurrence a WHERE a.provider_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM cdm_ours_fhir.provider b WHERE b.provider_id = a.provider_id)"
    }
  ]
}
