{
  "resourceType": "Library",
  "id": "dq-startend-device_exposure",
  "url": "https://fhir2omop.health-samurai.io/StructureDefinition/Library/dq-startend-device_exposure",
  "name": "dq_startend_device_exposure",
  "title": "device_exposure: device_exposure_start_date SHALL NOT be after device_exposure_end_date",
  "status": "active",
  "type": {
    "coding": [
      {
        "system": "http://hl7.org/fhir/uv/sql-on-fhir/CodeSystem/library-type",
        "code": "sqlquery"
      }
    ]
  },
  "extension": [
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-kahn-category",
      "valueCode": "plausibility"
    },
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-check-type",
      "valueString": "plausibleStartBeforeEnd"
    },
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-threshold-pct",
      "valueDecimal": 0
    },
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-severity",
      "valueCode": "error"
    }
  ],
  "parameter": [
    {
      "name": "cdmTable",
      "use": "in",
      "valueString": "device_exposure"
    }
  ],
  "content": [
    {
      "contentType": "text/sql",
      "data": "SELECT * FROM cdm_ours_fhir.device_exposure WHERE device_exposure_end_date IS NOT NULL AND device_exposure_start_date > device_exposure_end_date"
    }
  ]
}
