{
  "resourceType": "Library",
  "id": "dq-fk-person-location_id",
  "url": "https://fhir2omop.health-samurai.io/StructureDefinition/Library/dq-fk-person-location_id",
  "name": "dq_fk_person_location_id",
  "title": "person.location_id SHALL reference an existing location.location_id",
  "status": "active",
  "type": {
    "coding": [
      {
        "system": "http://hl7.org/fhir/uv/sql-on-fhir/CodeSystem/library-type",
        "code": "sqlquery"
      }
    ]
  },
  "extension": [
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-kahn-category",
      "valueCode": "conformance"
    },
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-check-type",
      "valueString": "isForeignKey"
    },
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-threshold-pct",
      "valueDecimal": 0
    },
    {
      "url": "https://fhir2omop.health-samurai.io/StructureDefinition/dq-severity",
      "valueCode": "error"
    }
  ],
  "parameter": [
    {
      "name": "cdmTable",
      "use": "in",
      "valueString": "person"
    },
    {
      "name": "cdmField",
      "use": "in",
      "valueString": "location_id"
    }
  ],
  "content": [
    {
      "contentType": "text/sql",
      "data": "SELECT a.* FROM cdm_ours_fhir.person a WHERE a.location_id IS NOT NULL AND NOT EXISTS (SELECT 1 FROM cdm_ours_fhir.location b WHERE b.location_id = a.location_id)"
    }
  ]
}
